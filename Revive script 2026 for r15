local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ===== Evitar múltiples ejecuciones =====
local existing = playerGui:FindFirstChild("UndertaleUI")
if existing then
	existing:Destroy()
end

-- ===== UI =====
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "UndertaleUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Fondo negro
local bg = Instance.new("Frame")
bg.Size = UDim2.new(1, 0, 1, 0)
bg.BackgroundColor3 = Color3.new(0, 0, 0)
bg.BackgroundTransparency = 1
bg.Visible = false
bg.Parent = screenGui

-- Texto principal
local textLabel = Instance.new("TextLabel")
textLabel.Size = UDim2.new(1, 0, 1, 0)
textLabel.BackgroundTransparency = 1
textLabel.TextScaled = true
textLabel.Font = Enum.Font.Arcade
textLabel.Parent = bg

-- HUD de vida
local healthLabel = Instance.new("TextLabel")
healthLabel.Size = UDim2.new(0, 200, 0, 50)
healthLabel.Position = UDim2.new(0, 20, 1, -60)
healthLabel.BackgroundTransparency = 1
healthLabel.TextScaled = true
healthLabel.Font = Enum.Font.Arcade
healthLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
healthLabel.Text = "HP: 100"
healthLabel.Parent = screenGui

-- ===== TEXTOS =====
local function showText(text, color, duration)
	bg.Visible = true
	bg.BackgroundTransparency = 0
	textLabel.Text = text
	textLabel.TextColor3 = color
	task.wait(duration)
	bg.Visible = false
end

-- ===== LÓGICA =====
local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")

	-- 🔥 FIX: actualizar HUD al respawn
	task.defer(function()
		healthLabel.Text = "HP: " .. math.floor(humanoid.Health)
	end)

	local attempts = 0
	local maxAttempts = 10
	local debounce = false
	local finalMode = false
	local internalChange = false
	local alive = true

	-- 🛡️ Control de regeneración
	local regenerating = false

	-- 🪂 Control de caída
	local falling = false
	local fallStartHeight = 0
	local fallProtectionDebounce = false

	local connections = {}

	local function cleanup()
		alive = false
		for _, c in ipairs(connections) do
			if c and c.Disconnect then
				c:Disconnect()
			end
		end
		table.clear(connections)
	end

	-- 📍 TELETRANSPORTE DIAGONAL
	local function teleportDiagonal()
		if not rootPart or not rootPart.Parent then
			return
		end

		-- 10 studs hacia atrás + 10 hacia la derecha
		local backward = -rootPart.CFrame.LookVector * 10
		local right = rootPart.CFrame.RightVector * 10

		-- Desplazamiento diagonal
		character:PivotTo(character:GetPivot() + backward + right)
	end

	-- ❤️ RECUPERACIÓN PROGRESIVA DE VIDA
	local function gradualRecovery()
		if regenerating or not alive or finalMode then
			return
		end

		regenerating = true

		-- Comenzamos desde 1 HP
		internalChange = true
		humanoid.Health = 1
		internalChange = false

		-- Recuperación de 1 en 1
		while alive
			and humanoid.Parent
			and humanoid.Health > 0
			and humanoid.Health < humanoid.MaxHealth
			and not finalMode do

			task.wait(0.1)

			if not alive or finalMode then
				break
			end

			internalChange = true

			local nextHealth = math.min(
				humanoid.Health + 1,
				humanoid.MaxHealth
			)

			humanoid.Health = nextHealth

			internalChange = false
		end

		regenerating = false
	end

	-- 🪂 RAYCAST DE DETECCIÓN DE CAÍDAS
	local RunService = game:GetService("RunService")

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {character}

	local function detectFall()
		if not alive or not rootPart.Parent then
			return
		end

		local velocityY = rootPart.AssemblyLinearVelocity.Y
		local humanoidState = humanoid:GetState()

		-- Detectar el inicio de una caída
		if velocityY < -50 and not falling then
			falling = true
			fallStartHeight = rootPart.Position.Y
		end

		if not falling then
			return
		end

		-- Raycast hacia abajo
		local rayOrigin = rootPart.Position
		local rayDirection = Vector3.new(0, -6, 0)

		local result = workspace:Raycast(
			rayOrigin,
			rayDirection,
			raycastParams
		)

		-- Detectar aterrizaje
		if result and humanoidState ~= Enum.HumanoidStateType.Freefall then
			falling = false

			local fallDistance = fallStartHeight - rootPart.Position.Y

			-- Solo activar ante caídas considerables
			if fallDistance >= 15
				and humanoid.Health > 0
				and not fallProtectionDebounce
				and not finalMode then

				fallProtectionDebounce = true

				-- Activar el sistema existente
				if humanoid.Health > humanoid.MaxHealth * 0.05 then
					humanoid.Health = humanoid.MaxHealth * 0.05
				end

				task.delay(1, function()
					fallProtectionDebounce = false
				end)
			end
		end
	end

	table.insert(connections, RunService.Heartbeat:Connect(detectFall))

	-- HUD en tiempo real
	table.insert(connections, humanoid.HealthChanged:Connect(function()
		healthLabel.Text = "HP: " .. math.floor(humanoid.Health)
	end))

	-- Lógica principal
	table.insert(connections, humanoid.HealthChanged:Connect(function(health)
		if not alive then return end
		if internalChange then return end
		if finalMode then return end
		if regenerating then return end

		if health <= humanoid.MaxHealth * 0.05
			and attempts < maxAttempts
			and not debounce then

			debounce = true
			attempts += 1

			print("Intento #" .. attempts)

			-- 📍 Teletransporte diagonal
			teleportDiagonal()

			if attempts == 1 then
				task.spawn(function()
					showText("YOU DIED", Color3.fromRGB(255,255,255), 3)
					showText("BUT YOU REFUSED TO THAT", Color3.fromRGB(255,0,0), 2)
				end)
			end

			internalChange = true

			-- ===== ÚLTIMA VIDA =====
			if attempts == maxAttempts then
				finalMode = true

				task.spawn(function()
					showText("LAST CHANCE", Color3.fromRGB(255,0,0), 2)
				end)

				humanoid.Health = humanoid.MaxHealth

				task.spawn(function()
					local drain = humanoid.MaxHealth / 100

					while alive and humanoid.Health > 0 do
						task.wait(1)

						if not alive then break end

						internalChange = true
						humanoid.Health = math.max(
							0,
							humanoid.Health - drain
						)
						internalChange = false
					end
				end)

			else
				-- ===== REVIVE NORMAL =====
				internalChange = false
				task.spawn(gradualRecovery)
			end

			internalChange = false
			task.wait(0.1)
			debounce = false
		end
	end))

	-- Al morir de verdad
	table.insert(connections, humanoid.Died:Connect(function()
		print("Murió realmente, reiniciando sistema")
		cleanup()
	end))
end

player.CharacterAdded:Connect(onCharacter)

if player.Character then
	onCharacter(player.Character)
end
